<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log4j2 Configuration File
    Configures logging behavior for the test automation framework
    Defines appenders (console and file), log patterns, and logger levels
-->
<Configuration status="WARN">
    <!-- Appenders - Define where and how logs are written -->
    <Appenders>
        <!-- Console Appender - Outputs logs to console/terminal -->
        <Console name="Console" target="SYSTEM_OUT">
            <!-- Log pattern: timestamp [thread] level logger - message -->
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
        
        <!-- 
            Rolling File Appender - Writes logs to files with rotation
            - Current log: logs/automation.log
            - Rotated logs: logs/automation-YYYY-MM-DD-N.log.gz (compressed)
            - Triggers: File size (10MB) or time-based (daily)
            - Keeps maximum 10 archived log files
        -->
        <RollingFile name="FileAppender" fileName="logs/automation.log" 
                     filePattern="logs/automation-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <!-- Rotate when file reaches 10MB -->
                <SizeBasedTriggeringPolicy size="10MB"/>
                <!-- Rotate daily -->
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <!-- Keep maximum 10 rolled files -->
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>
    
    <!-- Loggers - Control logging levels for different packages -->
    <Loggers>
        <!-- Framework-specific logger - INFO level and above -->
        <Logger name="com.automation" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        
        <!-- Selenium WebDriver logger - WARN level to reduce noise -->
        <Logger name="org.openqa.selenium" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        
        <!-- WebDriver Manager logger - WARN level to reduce noise -->
        <Logger name="io.github.bonigarcia.wdm" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>
        
        <!-- Root logger - Default for all other classes -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Root>
    </Loggers>
</Configuration>